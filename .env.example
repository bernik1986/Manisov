MANISOV_ENV=production
CORS_ALLOWED_ORIGINS=
# Preserve the existing Compose project and DB volume identity on adoption.
COMPOSE_PROJECT_NAME=manisov
POSTGRES_VOLUME=manisov_postgres_data
DATA_DIR=/var/www/Manisov
HTTP_BIND=0.0.0.0
HTTP_PORT=80
POSTGRES_DB=maritime
POSTGRES_USER=maritime
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg2://maritime:change-this-postgres-password@db:5432/maritime

JWT_SECRET_KEY=

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=Production Admin
